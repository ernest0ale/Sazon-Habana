# ============================================
# SAZÓN HABANA - Variables de Entorno
# ============================================
# Copia este archivo a `.env.local` y rellena con valores reales.

# ---------- SUPABASE ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------- SEGURIDAD ----------
# Mínimo 32 caracteres aleatorios. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
SESSION_SECRET=

# ---------- APLICACIÓN ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sazón Habana

# ---------- RATE LIMITING ----------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MS=3600000

# ---------- EMAIL (Resend) ----------
# Obtener en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Sazón Habana <noreply@sazonhabana.com>

# ---------- ANALÍTICA (Umami) ----------
# Obtener en https://cloud.umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js